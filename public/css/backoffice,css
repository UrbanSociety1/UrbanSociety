:root{--bo-bg:#070709;--bo-panel:#0e0e12;--bo-panel2:#15151a;--bo-line:#292930;--bo-red:#ff1027;--bo-text:#fff;--bo-muted:#92929c;--bo-width:252px}
body.urban-backoffice-page{padding-left:var(--bo-width)!important;transition:padding-left .2s ease;overflow-x:hidden}.urban-bo-sidebar{position:fixed;inset:0 auto 0 0;z-index:5000;width:var(--bo-width);height:100dvh;display:flex;flex-direction:column;padding:18px 14px;background:linear-gradient(180deg,#0b0b0e,#070709);border-right:1px solid var(--bo-line);box-shadow:18px 0 55px rgba(0,0,0,.26)}.urban-bo-brand{display:flex;align-items:center;gap:11px;padding:4px 7px 18px;border-bottom:1px solid var(--bo-line);flex:0 0 auto}.urban-bo-brand img{width:44px;height:44px;object-fit:contain}.urban-bo-brand strong{display:block;font-size:14px;letter-spacing:.07em}.urban-bo-brand span{display:block;margin-top:3px;color:var(--bo-muted);font-size:10px;text-transform:uppercase;letter-spacing:.1em}.urban-bo-nav{display:grid;gap:4px;padding:15px 0;overflow-y:auto;overflow-x:hidden;min-height:0;scrollbar-width:none;-ms-overflow-style:none}.urban-bo-nav::-webkit-scrollbar{display:none;width:0;height:0}.urban-bo-nav-label{padding:8px 10px 4px;color:#64646d;font-size:10px;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.urban-bo-link{display:flex;align-items:center;gap:11px;min-height:42px;padding:9px 12px;border:1px solid transparent;border-radius:11px;color:#d8d8dd;text-decoration:none;font-size:13px;font-weight:800;transition:.16s}.urban-bo-link:hover{background:#141419;border-color:#24242b;color:#fff}.urban-bo-link.active{background:linear-gradient(135deg,rgba(255,16,39,.16),rgba(255,16,39,.05));border-color:rgba(255,16,39,.34);color:#fff}.urban-bo-icon{width:23px;text-align:center;font-size:17px}.urban-bo-spacer{flex:1 1 auto;min-height:8px}.urban-bo-footer{padding-top:12px;border-top:1px solid var(--bo-line);flex:0 0 auto}.urban-bo-store{color:#ff8a96}.urban-bo-logout{width:100%;margin-top:4px;border:0;background:transparent;color:#8d8d96;text-align:left}.urban-bo-mobile-button{display:none;position:fixed;left:12px;top:12px;z-index:5100;width:44px;height:44px;border:1px solid #35353d;border-radius:12px;background:#101014;color:#fff;font-size:20px;box-shadow:0 10px 30px rgba(0,0,0,.35)}.urban-bo-overlay{display:none;position:fixed;inset:0;z-index:4900;background:rgba(0,0,0,.65);backdrop-filter:blur(3px)}body.urban-backoffice-page .admin-header,body.urban-backoffice-page .pos-header{display:none!important}body.urban-backoffice-page .admin-container{width:100%!important;max-width:none!important;margin:0!important;padding:24px 20px 70px!important}body.urban-backoffice-page .pos-layout,body.urban-backoffice-page .pos-history-section,body.urban-backoffice-page .pos-cash-section,body.urban-backoffice-page .pos-cash-history-section{width:calc(100% - 32px)!important;max-width:none!important}.urban-bo-page-badge{display:inline-flex;align-items:center;gap:7px;padding:6px 9px;border:1px solid #2b2b33;border-radius:999px;background:#111116;color:#b9b9c1;font-size:11px;font-weight:800}@media(max-width:900px){body.urban-backoffice-page{padding-left:0!important;padding-top:62px!important}.urban-bo-sidebar{width:min(285px,86vw);transform:translateX(-104%);transition:transform .2s ease}.urban-bo-sidebar.open{transform:translateX(0)}.urban-bo-mobile-button{display:grid;place-items:center}.urban-bo-overlay.open{display:block}body.urban-backoffice-page .admin-container{padding:14px 12px 60px!important}body.urban-backoffice-page .pos-layout,body.urban-backoffice-page .pos-history-section,body.urban-backoffice-page .pos-cash-section,body.urban-backoffice-page .pos-cash-history-section{width:calc(100% - 20px)!important}}@media(prefers-reduced-motion:reduce){body.urban-backoffice-page,.urban-bo-sidebar{transition:none}}